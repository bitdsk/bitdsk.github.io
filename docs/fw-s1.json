{
 "title": "Firmware upgrade For S1",
 "html": "\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<h2 class=\"wp-block-heading\">Board Version: S1</h2>\n\n\n\n<figure class=\"wp-block-table is-style-stripes\"><table class=\"has-fixed-layout\"><thead><tr><th>Time(M.D.Y)</th><th>Version</th><th>Description</th><th>Down</th></tr></thead><tbody><tr><td>04.09.2026</td><td>V_1.5</td><td>Fixed string issues<br>Added support for ckpool<br>However, using ckpool is still not recommended because it&#8217;s too difficult; you might not see any valid shares or your device listed on ckpool at all.</td><td><a href=\"https://www.bitdsk.org/s1firware/\">Online Free Burninfg</a></td></tr><tr><td>03.25.2026</td><td>V_1.3</td><td>The issue of certificate invalidation when obtaining coin price has been fixed.</td><td>Follow the new version</td></tr><tr><td>02.07.2026</td><td>V_1.2</td><td>1.Fixed city input, allowing entries like &#8220;London, GB&#8221; or &#8220;City,State,Country code&#8221;<br><br>2.Fixed two spelling errors.</td><td>Follow the new version</td></tr><tr><td>01.29.2026</td><td>V_1.1</td><td>1.Added support for driver ILI9341<br><br>2.Added screen brightness adjustment<br><br>3.Slightly improved hash</td><td>Follow the new version</td></tr><tr><td>&#8211;</td><td>V_1.0</td><td>Default</td><td>Follow the new version</td></tr><tr><td></td><td></td><td></td><td></td></tr></tbody></table></figure>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n",
